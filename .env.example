# Copia este archivo como  .env  y rellena con los datos de tu proyecto Firebase.
# Firebase Console > Configuración del proyecto > Tus apps > Configuración del SDK.
#
# OJO: estas claves VITE_* se incrustan en el JavaScript público del sitio.
# Eso es normal y esperado en Firebase: la seguridad real vive en firestore.rules,
# no en ocultar la apiKey.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Solo para los scripts de Node (no se envían al navegador) ---

# Ruta al JSON de la cuenta de servicio.
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada.
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json

# Ruta al Excel de invitados.
EXCEL_PATH=C:\Users\CEJA\Desktop\Invitados boda.xlsx

# URL pública del sitio, usada para construir los links de RSVP.
# En desarrollo: http://localhost:5173
BASE_URL=https://boda-llely-drix.vercel.app
