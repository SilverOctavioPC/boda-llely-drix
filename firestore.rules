rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /invitados/{invitadoId} {

      // Las DOS únicas cuentas que existen. Se crean a mano en la consola de
      // Firebase; no hay registro público.
      //
      // Es una lista blanca a propósito: cualquier otra cuenta que llegue a
      // existir no puede hacer nada, ni siquiera leer la lista. Antes `esNovios`
      // era "tener sesión y no ser el escáner", así que una cuenta creada por
      // error —o de más— habría tenido control total sobre los invitados.
      //
      // Deben coincidir con CORREO_NOVIOS y CORREO_ESCANER en src/lib/roles.js.
      // Hay un test (src/lib/reglas.test.js) que comprueba que no se desincronicen.
      function esNovios() {
        return request.auth != null
          && request.auth.token.email == 'novios@bodallelydrix.com';
      }

      // Cuenta limitada para quien escanea en la puerta. Mínimo privilegio:
      // puede leer la lista y marcar accesos, nada más. Si ese celular se
      // pierde, no se puede borrar a nadie ni alterar confirmaciones.
      function esEscaner() {
        return request.auth != null
          && request.auth.token.email == 'escaner@bodallelydrix.com';
      }

      // Cualquiera de las dos cuentas reconocidas.
      function esStaff() {
        return esNovios() || esEscaner();
      }

      // Lo único que la puerta puede tocar de un invitado.
      function soloRegistroDeAcceso() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['entradaRegistrada', 'fechaEntrada']);
      }

      // Un invitado del público solo puede tocar los campos de su confirmación
      // y su elección de menú. Cualquier otro campo (nombre, grupo,
      // acompanantes, entradaRegistrada...) queda bloqueado.
      function soloCamposDeConfirmacion() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['confirmacion', 'restricciones', 'mensaje', 'fechaConfirmacion',
                    'menu', 'menuAcompanantes']);
      }

      // Cuántos acompañantes tiene asignados HOY el invitado.
      // Tolera el formato antiguo (`acompanantes: []`) de la migración inicial.
      function numAcompanantes() {
        let a = resource.data.get('acompanantes', {});
        return (a is map && a.adultos is list && a.ninos is list)
          ? a.adultos.size() + a.ninos.size()
          : 0;
      }

      // El invitado elige su comida, pero NO puede regalarse lugares de más:
      // la lista de menús no puede ser más larga que sus acompañantes reales.
      function menuValido() {
        let ma = request.resource.data.get('menuAcompanantes', []);
        return ma is list && ma.size() <= numAcompanantes();
      }

      function confirmacionValida() {
        let d = request.resource.data;
        return d.confirmacion in ['Si', 'No']
          && (d.restricciones == null || (d.restricciones is string && d.restricciones.size() <= 300))
          && (d.mensaje == null || (d.mensaje is string && d.mensaje.size() <= 500))
          && menuValido();
      }

      // get: público. Hace falta para que el invitado abra su link y vea su nombre.
      // Solo sirve conociendo el ID exacto (aleatorio, 20 caracteres).
      allow get: if true;

      // list: bloqueado para el público. Esto es lo que impide que alguien
      // descargue la lista completa de invitados. Sin esta línea, el `get`
      // público expondría toda la colección.
      allow list: if esStaff();

      // Validación de un invitado dado de alta desde el panel.
      // El script de migración usa el Admin SDK y se salta estas reglas.
      function invitadoValido() {
        let d = request.resource.data;
        return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
          && d.grupo in ['Llely', 'Drix']
          && d.categoria in ['Adulto', 'Niño', 'Bebé']
          && (d.sexo == null || d.sexo in ['Mujer', 'Hombre'])
          && d.confirmacion in ['Si', 'No', 'Pendiente']
          && d.entradaRegistrada is bool
          && d.acompanantes.adultos is list
          && d.acompanantes.adultos.size() <= 15
          && d.acompanantes.ninos is list
          && d.acompanantes.ninos.size() <= 15;
      }

      // Tres vías de escritura, de más a menos privilegio:
      //   1. Los novios pueden editar cualquier campo.
      //   2. La puerta, solo el registro de acceso.
      //   3. El invitado, solo su confirmación y su menú.
      allow update: if esNovios()
        || (esEscaner() && soloRegistroDeAcceso())
        || (soloCamposDeConfirmacion() && confirmacionValida());

      // Alta y baja de invitados: solo los novios. La puerta no borra a nadie.
      allow create: if esNovios() && invitadoValido();
      allow delete: if esNovios();
    }

    // Configuración del menú del banquete.
    // Lectura pública: el invitado necesita ver los platos al confirmar; no
    // contiene datos personales, solo nombres de platos y bebidas.
    // Escritura solo de los novios: la puerta no cambia el menú de la boda.
    match /configuracion/{documento} {
      // La misma lista blanca que arriba. Las funciones de /invitados no
      // alcanzan aquí, así que el correo se repite: es el precio de no tener
      // funciones globales en las reglas.
      allow get: if true;
      allow list: if request.auth != null
        && request.auth.token.email in ['novios@bodallelydrix.com',
                                        'escaner@bodallelydrix.com'];
      allow write: if request.auth != null
        && request.auth.token.email == 'novios@bodallelydrix.com';
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
